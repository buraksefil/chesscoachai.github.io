{
  "name": "chesscoach-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "clean": "rm -rf .next out docs",
    "build:gh": "GH_PAGES=true next build",
    "export:docs": "rm -rf docs && mkdir -p docs && cp -R out/. docs/",
    "deploy:gh": "npm run clean && npm run build:gh && npm run export:docs && git add -A && git commit -m \"deploy: gh-pages\" && git push",
    "start": "next start"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "next": "15.5.2",
    "next-auth": "^4.24.11",
    "openai": "^5.16.0",
    "react": "19.1.0",
    "react-chessboard": "^4.2.0",
    "react-dom": "19.1.0",
    "stockfish": "^17.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
